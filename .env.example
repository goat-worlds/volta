# VOLTA — variables d'environnement
#
# Copier en .env et renseigner. Ne jamais commiter le .env réel.

# ── Base de données ────────────────────────────────────────────────
# MySQL 8 ou MariaDB. createDatabaseIfNotExist crée la base au premier
# démarrage si elle n'existe pas.
DB_URL=jdbc:mysql://localhost:3306/volta?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=volta
DB_PASSWORD=

# Dialecte Hibernate. MariaDB et MySQL ne partagent pas la même syntaxe de
# verrou : sur MariaDB, un dialecte MySQL générique produit un « FOR UPDATE OF
# alias » que le serveur refuse, et l'acceptation d'un devis échoue.
#   MariaDB : org.hibernate.dialect.MariaDBDialect
#   MySQL 8 : org.hibernate.dialect.MySQLDialect
HIBERNATE_DIALECT=org.hibernate.dialect.MariaDBDialect

# ── Schéma ─────────────────────────────────────────────────────────
# Le projet n'embarque aucun outil de migration : Hibernate génère et met à
# jour le schéma.
#
#   update   développement, et PREMIER démarrage en production pour créer
#            les tables
#   validate production courante — vérifie que le schéma correspond aux
#            entités sans jamais le modifier
#   none     schéma géré entièrement hors application
#
# Laisser « update » en production autoriserait Hibernate à modifier le schéma
# à chaque déploiement.
DDL_AUTO=validate

# ── Serveur ────────────────────────────────────────────────────────
# Port d'écoute. En local, inutile : la valeur par défaut est 9000. Les
# hébergeurs (Render, Fly, Railway) imposent le leur par cette variable et
# sondent ce port — ne pas la respecter fait échouer le déploiement.
PORT=9000

# ── Sécurité ───────────────────────────────────────────────────────
# Durée de validité d'une session, en jours. L'expiration est glissante :
# chaque appel à /api/auth/me la repousse.
SESSION_DURATION_DAYS=7

# Jeu de démonstration : trois comptes de test et un catalogue d'essai, créés
# au démarrage sur une base vide.
#
# Leur mot de passe est écrit en clair dans les sources d'un dépôt public. Sur
# toute instance accessible depuis l'extérieur, cette variable DOIT valoir
# false : sinon quiconque connaît le projet dispose d'un accès administrateur,
# et supprimer les comptes ne suffit pas — ils reviennent au redémarrage.
#
# Le profil « render » la force déjà à false ; le défaut côté code est false
# également. Elle n'est mise à true que pour le développement local.
VOLTA_SEED_DEMO=true

# Premier administrateur d'une instance sans jeu de démonstration.
#
# L'inscription par le site ne délivre que des comptes client : sans ces deux
# variables, une base neuve n'a personne pour référencer ni publier un engin.
#
# L'amorçage ne joue que tant qu'aucun administrateur n'existe — un mot de passe
# oublié dans la configuration ne rouvre donc pas d'accès à chaque redémarrage.
# Si l'adresse correspond à un compte déjà inscrit, ce compte est promu et son
# mot de passe n'est pas touché.
#
# VOLTA_ADMIN_EMAIL=
# VOLTA_ADMIN_PASSWORD=
# VOLTA_ADMIN_NAME=Administration

# Origines autorisées à appeler l'API, séparées par des virgules.
# Ne jamais mettre « * » : les requêtes portent des identifiants, et toute
# origine autorisée pourrait alors agir avec les droits du visiteur connecté.
VOLTA_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ───────────────────────────────────────────────────────
# URL de l'API vue depuis le navigateur. En développement, le proxy Vite
# redirige /api vers le backend et cette variable est inutile.
#
# En production, le segment « /api » final est obligatoire : le client d'API
# concatène cette base au chemin de chaque appel, qui vaut « /equipment » et
# non « /api/equipment ». Sans lui, tous les appels tombent en 404.
#
#   correct   https://volta-backend.onrender.com/api
#   faux      https://volta-backend.onrender.com
#
# Elle est lue à la CONSTRUCTION du site, pas à son exécution : la modifier
# demande un redéploiement pour prendre effet.
VITE_API_URL=/api

# ── Hébergement ────────────────────────────────────────────────────
# Ces variables ne servent qu'en ligne, activées par le profil « render ».
# Le blueprint render.yaml les renseigne automatiquement depuis la base
# provisionnée : rien à saisir à la main.
#
# SPRING_PROFILES_ACTIVE=render
# PGHOST=
# PGPORT=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
